rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar para verificar si el usuario es administrador
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Función auxiliar para verificar si el usuario es staff del bar específico
    function isVenueStaff(venueId) {
      return request.auth != null && 
        (request.auth.token.role == 'admin' || 
        (request.auth.token.role == 'venue_staff' && request.auth.token.assignedVenueId == venueId));
    }

    // ==========================================================
    // 1. COLECCIÓN 'venues' (Bares, Antros, Terrazas de Colima)
    // ==========================================================
    match /venues/{venueId} {
      // Lectura pública: Clientes de la app pueden ver el directorio, aforo y estatus de seguridad
      allow read: if true;

      // El staff puede actualizar información operacional básica (promos, música en vivo, redes)
      // pero NUNCA alterar directamente 'securityStatus', 'stats' ni 'currentOccupancyPercent'.
      // Esos campos se gestionan exclusivamente por Cloud Functions con Admin SDK.
      allow update: if isVenueStaff(venueId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'securityStatus',
          'stats',
          'currentOccupancyPercent',
          'vibeScore'
        ]);

      // Creación y borrado reservados para administradores globales
      allow create, delete: if isAdmin();
    }

    // ==========================================================
    // 2. COLECCIÓN 'live_vibes' (Check-ins y señales en vivo)
    // ==========================================================
    // La ingesta directa desde el cliente está BLOQUEADA para garantizar
    // Proof of Proximity (150m) y hash HMAC de anonimato en el backend.
    match /live_vibes/{vibeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ==========================================================
    // 3. COLECCIÓN 'incident_reports' (Reportes individuales)
    // ==========================================================
    // Colección sensible con coordenadas GPS y hashes de dispositivos.
    // Blindada al público para evitar filtraciones y difamación.
    match /incident_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ==========================================================
    // 4. COLECCIÓN 'active_incidents' (Consenso de Alertas en Vivo)
    // ==========================================================
    match /active_incidents/{venueId} {
      // Solo las alertas VERIFICADAS son legibles públicamente.
      // Los reportes 'under_review' solo son visibles para staff del local o admins.
      allow read: if resource.data.status == 'active_alert' || isVenueStaff(venueId);
      
      // La escritura directa está prohibida. Pasa por Cloud Function con cuórum.
      allow write: if false;
    }

    // ==========================================================
    // 5. COLECCIÓN 'device_reputations' (Sistema de Shadowban)
    // ==========================================================
    // Estrictamente inaccesible desde clientes para evitar ingeniería inversa de troles.
    match /device_reputations/{reputationId} {
      allow read, write: if false;
    }
  }
}
